# 基础配置
port 6379
daemonize no
logfile "/var/log/redis/redis-slave1.log"
dir "/var/lib/redis/slave1"

masterauth "yjk19308769931"
requirepass "yjk19308769931"

# 核心复制配置
replicaof 192.168.189.137 6379
replica-read-only yes

# Generated by CONFIG REWRITE
supervised systemd
latency-tracking-info-percentiles 50 99 99.9
save 3600 1
save 300 100
save 60 10000
user default on #2ba2c2f6aa6708d9404bcd3c21a639e7e334a4d9d440003f54470fdc27b6fdba ~* &* +@all

