upstream web_pool { 
   server 192.168.189.131:80;
   server 192.168.189.132:80;
 }

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://web_pool;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
