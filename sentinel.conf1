# 基础配置
port 26379
bind 0.0.0.0
daemonize no
protected-mode no
logfile "/var/log/redis/sentinel log"
dir "/var/lib/redis/sentinel"

# 监控主节点（指向最初的主库）
sentinel monitor mymaster 192.168.189.137 6379 2

# 认证（主库 requirepass）
sentinel auth-pass mymaster yjk19308769931

# 故障判定与切换
sentinel down-after-milliseconds mymaster 5000
sentinel failover-timeout mymaster 60000

# Generated by CONFIG REWRITE
supervised systemd
latency-tracking-info-percentiles 50 99 99.9
user default on nopass ~* &* +@all
sentinel myid 24f08e3461d82ac972a9efabad129d7499c9d23b
sentinel config-epoch mymaster 2
sentinel leader-epoch mymaster 2
sentinel current-epoch 2

sentinel known-replica mymaster 192.168.189.136 6379

sentinel known-replica mymaster 192.168.189.138 6379

sentinel known-replica mymaster 192.168.189.135 6379

sentinel known-sentinel mymaster 192.168.189.138 26379 925c4fc5c1b7e3fd24e306d8f66285f6f4309c15

sentinel known-sentinel mymaster 192.168.189.137 26379 3a0fc77bd68fb6149c8bcd7aa9d0a8457ddd667b

